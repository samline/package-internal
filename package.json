{
  "name": "@samline/internal",
  "version": "1.0.0",
  "description": "Shared DOM helpers (auto-init, data-* readers, element targets, reduced motion) bundled into @samline packages at build time. Not a standalone public API.",
  "keywords": [
    "samline",
    "dom",
    "data-attributes",
    "auto-init",
    "prefers-reduced-motion",
    "utilities"
  ],
  "author": "Samuel Olvera (samline)",
  "license": "MIT",
  "homepage": "https://github.com/samline/package-internal#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samline/package-internal.git"
  },
  "bugs": {
    "url": "https://github.com/samline/package-internal/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.9.1",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf dist coverage",
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "size": "node scripts/check-size.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run format:check && bun run typecheck && bun run test:coverage && bun run build && bun run size",
    "prepublishOnly": "bun run clean && bun run build && bun run typecheck && bun run test:coverage",
    "release": "bun run check && pnpm publish"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "@vitest/coverage-v8": "^5.0.1",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "size": {
    "./dist/index.js": 1200
  }
}
